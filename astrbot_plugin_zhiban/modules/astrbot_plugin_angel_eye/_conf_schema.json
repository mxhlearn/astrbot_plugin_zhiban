{
  "history_api_mode": {
    "type": "string",
    "description": "历史分页接口",
    "hint": "现服务器使用 legacy_seq；SnowLuma 2.4.2 使用 snowluma_v24。切换时重建历史缓存。",
    "default": "legacy_seq",
    "options": [
      "legacy_seq",
      "snowluma_v24"
    ]
  },
  "max_pages": {
    "type": "int",
    "description": "每次同步最大页数",
    "default": 20
  },
  "page_size": {
    "type": "int",
    "description": "每页消息数",
    "default": 50
  },
  "page_timeout": {
    "type": "int",
    "description": "单页超时秒数",
    "default": 10
  },
  "sync_timeout": {
    "type": "int",
    "description": "单方向同步时限秒数",
    "default": 30
  }
}